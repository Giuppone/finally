# Copy to .env and fill in. .env is gitignored; this file is committed.
# The backend reads these from os.environ only — it never parses .env itself.
# Delivery is via `docker run --env-file .env` (or compose `env_file:`).

# Required: OpenRouter API key for LLM chat functionality.
# If this is empty AND LLM_MOCK is not "true", the backend fails fast at startup.
OPENROUTER_API_KEY=

# Optional: Massive (Polygon.io) API key for real market data.
# Set and non-empty -> the backend PROBES what the key is entitled to and resolves to
#   LIVE      (Starter+: real snapshots polled every ~15s)
#   ANCHORED  (Basic: real previous closes as the session anchor, simulated intraday motion)
# Absent, empty, or unusable -> SIMULATED (the built-in GBM simulator).
# There is deliberately no env var to force a mode: a hand-set mode could select LIVE on a
# key that cannot serve it, which is the exact failure the probe exists to catch (PLAN §13.9).
MASSIVE_API_KEY=

# Optional: set to "true" for deterministic mock LLM responses (E2E tests, no API key needed).
LLM_MOCK=false

# ---- Optional tuning ---------------------------------------------------------
# All of these have working defaults; a bad value logs a warning and falls back rather than
# failing startup.

# Seed for the market simulator's RNG. Set it to make a demo reproducible.
SIM_SEED=

# Seconds between Massive polls in LIVE mode. Ignored in the simulated modes. Default 15.
MARKET_POLL_INTERVAL_S=

# In LIVE mode, fall back to simulated motion when the market is closed, so a weekend demo
# still moves instead of showing ten frozen prices. Default "true".
MARKET_CLOSED_FALLBACK=

# Absolute path to the SQLite file. The container sets this to /app/db/finally.db, which is
# where the named volume mounts. Locally it defaults to <repo>/db/finally.db.
FINALLY_DB_PATH=

# Directory holding the built frontend. The container sets this to /app/static. Locally it
# defaults to <repo>/frontend/out, so a local `npm run build` is served automatically.
FINALLY_STATIC_DIR=
